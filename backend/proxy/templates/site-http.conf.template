server {
    listen 80;
    server_name __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        add_header Retry-After "300" always;
        default_type text/plain;
        return 503 "HTTPS certificate provisioning in progress\n";
    }
}
